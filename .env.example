# ═══════════════════════════════════════════════════════════════════════════════
#  NOVA — ROOT ENVIRONMENT (Full-Stack Local Development Reference)
#
#  ACTUAL FILE LOCATIONS — SET THESE, NOT THIS ROOT FILE:
#    ├─ Backend (local dev):  backend/.env     (copy backend/.env.example)
#    ├─ Backend (Render):     Render Dashboard → Environment tab (ALL 28 keys
#    │                          pre-configured in render.yaml:14-123)
#    ├─ Frontend (local dev): frontend/.env.local  (copy frontend/.env.example)
#    └─ Frontend (Vercel):    Vercel Dashboard → Project → Settings → Env Vars
#
#  SECTION ORDER MATCHES: render.yaml ←→ backend/.env.example ←→ root .env.example
# ═══════════════════════════════════════════════════════════════════════════════

# ┌─────────────────────────────────────────────────────────────────────────────
# │  BACKEND — RENDER  (ALL Settings fields)
# └─────────────────────────────────────────────────────────────────────────────

# ─── 1. CRITICAL REQUIRED (3 vars) ──────────────────────────────────────────
# Get key: https://console.x.ai/   ← MANDATORY (no default)
GROK_API_KEY=

# Render auto-generates. For local dev use any random string
SECRET_KEY=nova-super-secret-key-change-in-production

# Comma-separated Vercel URLs. LOCAL DEV: leave EMPTY (defaults localhost + *)
# PRODUCTION EXAMPLE:
# CORS_ORIGINS=https://nova-frontend.vercel.app,https://www.mydomain.com
CORS_ORIGINS=

# ─── 2. SERVER (7 vars) ─────────────────────────────────────────────────────
# development | production | staging
ENVIRONMENT=development

# Render auto-sets at runtime. Local dev = localhost:5000
HOST=0.0.0.0
PORT=5000

# False on Render / production!
DEBUG=True

# Python runtime (leave as-is)
PYTHONUNBUFFERED=1
PYTHONPATH=/app

# ─── 3. IDENTITY (2 vars) ───────────────────────────────────────────────────
ASSISTANT_NAME=Nova
WAKE_WORD=hey nova

# ─── 4. AI / GROK (xAI) (3 vars) ───────────────────────────────────────────
# grok-3-fast (fast+accurate) | grok-3 | grok-3-mini
GROK_MODEL=grok-3-fast
GROK_BASE_URL=https://api.x.ai/v1

# 512 = default balanced
GROK_MAX_TOKENS=512

# ─── 5. VOICE ENGINE (5 vars) ───────────────────────────────────────────────
VOICE_RATE=180
VOICE_GENDER=female
LISTEN_TIMEOUT=5
PHRASE_TIME_LIMIT=8
LANGUAGE=en-in

# ─── 6. PATHS (5 vars) ──────────────────────────────────────────────────────
DATA_DIR=./backend/data
NOTES_DIR=./backend/data/notes
SCREENSHOTS_DIR=./backend/data/screenshots
OUTPUT_DIR=./backend/data/output
MEMORY_FILE=./backend/data/memory.json

# ─── 7. USER ENVIRONMENT PATHS (4 vars) ─────────────────────────────────────
USER_HOME=~/
PROJECTS_DIR=~/Desktop
DOWNLOADS_DIR=~/Downloads
DOCUMENTS_DIR=~/Documents

# ─── 8. APP PATHS DICT (ADVANCED) ───────────────────────────────────────────
APP_PATHS=

# ─── 9. WEBSITE SHORTCUTS DICT (ADVANCED) ───────────────────────────────────
WEBSITE_SHORTCUTS=

# ┌─────────────────────────────────────────────────────────────────────────────
# │  FRONTEND — VERCEL  (all keys MUST start with VITE_ prefix)
# └─────────────────────────────────────────────────────────────────────────────

# ─── REQUIRED (1 var) ───────────────────────────────────────────────────────
VITE_API_URL=

# ─── OPTIONAL Identity (2 vars) ──────────────────────────────────────────────
VITE_APP_NAME=Nova
VITE_ASSISTANT_NAME=Nova

# ─── OPTIONAL Feature Toggles (3 vars) ───────────────────────────────────────
VITE_ENABLE_VOICE=true
VITE_ENABLE_WAKE_WORD=true
VITE_WAKE_WORD=hey nova
